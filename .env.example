# Next.js Environment Variables untuk Deployment di Vercel

# 1. URL Backend API Laravel Production
# Ganti dengan URL domain API Backend Laravel Anda (misal yang di-host di Railway, Render, Fly.io, atau VPS)
NEXT_PUBLIC_API_URL=https://your-backend-api-domain.com/api

# 2. (Opsional) Supabase Client Configuration jika diakses langsung dari Frontend
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
